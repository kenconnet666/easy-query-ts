{
  "name": "@zerodep-dev/easy-query-ts-oracle",
  "version": "0.3.0",
  "description": "Oracle dialect and driver adapter (oracledb Thin mode) for @zerodep-dev/easy-query-ts, rendering per server version",
  "license": "Apache-2.0",
  "author": "lionheart (https://github.com/kenconnet666)",
  "homepage": "https://github.com/kenconnet666/easy-query-ts#readme",
  "bugs": {
    "url": "https://github.com/kenconnet666/easy-query-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/easy-query-ts.git",
    "directory": "packages/oracle"
  },
  "keywords": [
    "oracle",
    "oracledb",
    "orm",
    "easy-query"
  ],
  "exports": {
    ".": {
      "@easy-query-ts/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dialect": {
      "@easy-query-ts/source": "./src/dialect.ts",
      "types": "./dist/dialect.d.ts",
      "default": "./dist/dialect.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@zerodep-dev/easy-query-ts": "workspace:^",
    "oracledb": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@zerodep-dev/easy-query-ts": "workspace:*",
    "@zerodep-dev/easy-query-ts-test": "workspace:*",
    "oracledb": "catalog:",
    "@types/oracledb": "catalog:"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "tsc -b tsconfig.build.json"
  },
  "peerDependenciesMeta": {
    "oracledb": {
      "optional": true
    }
  }
}
